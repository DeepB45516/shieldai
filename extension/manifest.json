{
  "manifest_version": 2,
  "name": "ShieldAI Security",
  "version": "3.1.0",
  "description": "AI-powered security scanner",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "downloads",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background/background.js"],
    "persistent": true
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/content.js"],
    "run_at": "document_idle"
  }],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shieldai@extension",
      "strict_min_version": "91.0"
    }
  }
}
